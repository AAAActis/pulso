# Pulso API - Production Environment Variables
# Copy to .env and fill in the values

# Redis connection (optional - if not set, HybridCache operates in L1-only mode)
# Format: host:port,password=xxx,ssl=True,abortConnect=False
REDIS_CONNECTION=

# CORS allowed origin (production)
# Must match exactly the domain serving the frontend
CORS_ALLOWED_ORIGIN=https://s-portfolio.bbasolutions.ar

# Optional: Override default rate limits (requests per minute)
# RATE_LIMIT_GLOBAL=60
# RATE_LIMIT_LAB=5

# Optional: Custom SQLite connection string
# CONNECTION_STRING=Data Source=/data/pulso.db;Cache=Shared;Mode=ReadWriteCreate;Pooling=true